<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>MyContacts - {% apply striptags %}{% block title %}Welcome!{% endblock %}{% endapply %}</title>
        <link rel="icon" href="{{ asset('contact-card.ico') }}" type="image/x-icon">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&icon_names=delete,edit&display=block" rel="stylesheet">
        {% block stylesheets %}
            <style>
                footer {
                    color: white;
                    background-color: rgba(0, 0, 0, 0.25);
                }
                body {
                    padding: 0;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="container-xxl">
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_contact') }}">Contacts</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_category') }}">
                                Catégories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_contact_create') }}">
                                Ajouter un contact
                            </a>
                        </li>
                    </ul>
                    <form class="d-flex" role="search">
                        <input class="form-control me-2" type="search" placeholder="Recherche" aria-label="Search"/>
                        <button class="btn btn-outline-success" type="submit">Recherche</button>
                {% if app.user %}
                    <a href="#" class="btn btn-secondary ms-2">Déconnexion</a>
                {% else %}
                    <a href="#" class="btn btn-primary ms-2">Connexion</a>
                {% endif %}
                    </form>
                </div>
            </div>
        </nav>
        <main class="mt-3 mx-lg-3 mb-5 text-center">
            <h1>{{ block('title') }}</h1>
            {% block main %}
            {% endblock %}
        </main>
        <footer class="p-3">
            <p>MyContacts - © 2025</p>
        </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>
