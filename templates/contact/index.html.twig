{% extends 'base.html.twig' %}

{% block title %}
    Liste des contacts{% if app.request.query.get('search') %} contenant <em class="text-secondary">{{ app.request.query.get('search') }}</em>{% endif %}
{% endblock %}

{% block main %}
    <form method="get" action="{{ path('app_contact') }}" class="mb-3">
        <input type="text" name="search" value="{{ app.request.query.get('search') }}" placeholder="Rechercher un contact">
        <button type="submit">Rechercher</button>
    </form>

    {% include 'contact/_contacts.html.twig' %}

{% endblock %}
