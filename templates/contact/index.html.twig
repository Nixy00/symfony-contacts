{% extends 'base.html.twig' %}

{% block title %}Liste des contacts{% endblock %}

{% block main %}
    <form method="get" action="{{ path('app_contact') }}" class="mb-3">
        <input type="text" name="search" placeholder="Rechercher un contact">
        <button type="submit">Rechercher</button>
    </form>

    <ul class="contacts">
        {% for contact in contacts %}
            <li>
                <a href="{{ path('app_contact_id', {id: contact.id}) }}">
                    <span class="lastname">{{ contact.lastname }}</span>,
                    <span class="firstname">{{ contact.firstname }}</span>
                </a>
            </li>
        {% else %}
            <li>Aucun contact trouvé.</li>
        {% endfor %}
    </ul>

{% endblock %}
