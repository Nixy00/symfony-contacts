{% extends 'base.html.twig' %}

{% block title %}Liste des contacts{% endblock %}

{% block body %}

    <h1>Liste des contacts</h1>
    <ul>
        {% for contact in contacts %}
            <li>{{ contact.lastname }}, {{ contact.firstname }}</li>
        {% else %}
            <li>Aucun contact trouvé.</li>
        {% endfor %}
    </ul>

{% endblock %}
