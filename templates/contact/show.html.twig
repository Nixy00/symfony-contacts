{% extends 'base.html.twig' %}

{% block title %}
    {{ contact.firstname }} {{ contact.lastname }}
{% endblock %}

{% block main %}

    <form method="get" action="{{ path('app_contact') }}" class="mb-3">
        <input type="text" name="search" value="{{ app.request.query.get('search') }}" placeholder="Rechercher un contact">
        <button type="submit">Rechercher</button>
    </form>

    <dl>
        <dt>Prénom</dt>
        <dd>{{ contact.firstname }}</dd>

        <dt>Nom</dt>
        <dd>{{ contact.lastname }}</dd>

        <dt>Email</dt>
        <dd>{{ contact.email }}</dd>

        <dt>Téléphone</dt>
        <dd>{{ contact.phone }}</dd>

        <dt>Catégorie</dt>
        <dd>{{ contact.category.name ?? 'Non définie' }}</dd>
    </dl>
{% endblock %}
