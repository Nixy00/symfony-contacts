{% extends 'base.html.twig' %}

{% block title %}
    {{ contact.firstname }} {{ contact.lastname }}
{% endblock %}

{% block main %}
    <h1>{{ contact.firstname }} {{ contact.lastname }}</h1>

    <dl>
        <dt>Prénom</dt>
        <dd>{{ contact.firstname }}</dd>

        <dt>Nom</dt>
        <dd>{{ contact.lastname }}</dd>

        <dt>Email</dt>
        <dd>{{ contact.email }}</dd>

    </dl>
{% endblock %}
