{% extends 'base.html.twig' %}

{% block title %}Suppression de {{ contact.lastname }}, {{ contact.firstname }}{% endblock %}

{% block main %}
    <h1>Suppression de {{ contact.lastname }}, {{ contact.firstname }}</h1>

    {{ form_start(form, { attr: { class: 'd-flex gap-2' } }) }}
    {{ form_row(form.delete, { label: 'Supprimer', attr: { class: 'btn btn-primary flex-fill' } }) }}
    {{ form_row(form.cancel, { label: 'Annuler', attr: { class: 'btn btn-secondary flex-fill' } }) }}
    {{ form_end(form) }}
{% endblock %}
