<div class="container mt-3">
    <ul class="contacts list-group">
        {% for contact in contacts %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_contact_update', { id: contact.id }) }}"
                           class="text-warning"
                           aria-label="Modifier {{ contact.lastname }}, {{ contact.firstname }}">
                            <span class="material-symbols-outlined">edit</span>
                        </a>

                        <a href="{{ path('app_contact_delete', { id: contact.id }) }}"
                           class="text-danger"
                           aria-label="Supprimer {{ contact.lastname }}, {{ contact.firstname }}">
                            <span class="material-symbols-outlined">delete</span>
                        </a>
                    {% endif %}

                    <a href="{{ path('app_contact_id', { id: contact.id }) }}" class="contact"
                       aria-label="Consulter la fiche contact de {{ contact.lastname }}, {{ contact.firstname }}">
                        <span class="lastname">{{ contact.lastname }}</span>,
                        <span class="firstname">{{ contact.firstname }}</span>
                    </a>
                </div>

                {% if show_category??true and contact.category is not null %}
                    <span class="badge bg-primary">
                        <a href="{{ path('app_category_show', {id: contact.category.id}) }}"
                           class="nav-link text-white p-0"
                           aria-label="Consulter la catégorie {{ contact.category.name }}">
                            {{ contact.category.name }}
                        </a>
                    </span>
                {% endif %}
            </li>
        {% else %}
            <li class="list-group-item text-muted">
                Aucun contact
            </li>
        {% endfor %}
    </ul>
</div>
