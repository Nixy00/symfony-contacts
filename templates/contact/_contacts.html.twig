<div class="container mt-3">
    <ul class="contacts list-group">
        {% for contact in contacts %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a href="{{ path('app_contact_id', { id: contact.id }) }}">
                    <span class="lastname">{{ contact.lastname }}</span>,
                    <span class="firstname">{{ contact.firstname }}</span>
                </a>

                {% if show_category??true and contact.category is not null %}
                    <span class="badge bg-primary">
                        <a href="{{ path('app_category_show', {id: contact.category.id}) }}" class="nav-link text-white p-0">
                            {{ contact.category.name }}
                        </a>
                    </span>
                {% endif %}
            </li>
        {% else %}
            <li class="list-group-item text-muted">
                Aucun contact
            </li>
        {% endfor %}
    </ul>
</div>
