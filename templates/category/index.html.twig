{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block main %}
    <div class="container mt-3">
        <ul class="list-group">
            {% for category in categories %}
                <li class="list-group-item">
                    {{ category.name }}
                </li>
            {% else %}
                <li class="list-group-item text-muted">
                    Aucune catégorie
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
